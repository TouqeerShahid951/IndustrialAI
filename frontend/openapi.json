  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Capabilities"
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/Zone"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Zones"
          },
          "device": {
            "type": "string",
            "enum": [
              "mps",
              "cpu"
            ],
            "title": "Device",
            "default": "mps"
          },
          "camera": {
            "type": "string",
            "maxLength": 100,
            "title": "Camera",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "capabilities"
        ],
        "title": "Analysis"
      },
      "Assessment": {
        "properties": {
          "person_observations": {
            "type": "integer",
            "title": "Person Observations"
          },
          "eligible_smoking_observations": {
            "type": "integer",
            "title": "Eligible Smoking Observations"
          },
          "smoking": {
            "type": "string",
            "title": "Smoking"
          },
          "no_helmet": {
            "type": "string",
            "title": "No Helmet"
          },
          "intrusion": {
            "type": "string",
            "title": "Intrusion"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "person_observations",
          "eligible_smoking_observations",
          "smoking",
          "no_helmet",
          "intrusion"
        ],
        "title": "Assessment"
      },
      "Capability": {
        "type": "string",
        "enum": [
          "fire",
          "smoke",
          "smoking",
          "no_helmet",
          "intrusion"
        ],
        "title": "Capability"
      },
      "CapabilityResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed",
              "disabled"
            ],
            "title": "Status"
          },
          "assessability": {
            "type": "string",
            "title": "Assessability"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "assessability"
        ],
        "title": "CapabilityResult"
      },
      "Export": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "mp4"
            ],
            "title": "Format"
          },
          "incident_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "format"
        ],
        "title": "Export"
      },
      "FramePreview": {
        "properties": {
          "source": {
            "type": "number",
            "title": "Source"
          },
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          }
        },
        "type": "object",
        "required": [
          "source",
          "artifact_id"
        ],
        "title": "FramePreview"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentEvidence": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "default": ""
          },
          "level": {
            "type": "string",
            "title": "Level",
            "default": ""
          },
          "track": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track"
          },
          "zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          },
          "entry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "IncidentEvidence"
      },
      "IncidentRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "kind": {
            "$ref": "#/components/schemas/Capability"
          },
          "origin": {
            "type": "string",
            "enum": [
              "model",
              "manual"
            ],
            "title": "Origin"
          },
          "start": {
            "type": "number",
            "title": "Start"
          },
          "end": {
            "type": "number",
            "title": "End"
          },
          "evidence": {
            "$ref": "#/components/schemas/IncidentEvidence"
          },
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "confirmed",
                  "false_alarm",
                  "uncertain"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "created": {
            "type": "string",
            "title": "Created"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "job_id",
          "kind",
          "origin",
          "start",
          "end",
          "evidence",
          "decision",
          "note",
          "version",
          "created",
          "reviewed_at"
        ],
        "title": "IncidentRecord"
      },
      "InitialReview": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "confirmed",
              "uncertain"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "InitialReview"
      },
      "JobConfiguration": {
